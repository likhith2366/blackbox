// ---------------------------------------------------------------- logs: the services' own JSONL files -> Loki
local.file_match "demo_logs" {
  path_targets = [{"__path__" = "/telemetry/logs/*.jsonl", "job" = "blackbox-demo"}]
}

loki.source.file "demo_logs" {
  targets    = local.file_match.demo_logs.targets
  forward_to = [loki.process.demo_logs.receiver]
}

loki.process "demo_logs" {
  stage.json {
    expressions = {level = "level", service = "service", ts = "ts"}
  }
  stage.labels {
    values = {level = "", service = ""}
  }
  stage.timestamp {
    source = "ts"
    format = "RFC3339Nano"
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ---------------------------------------------------------------- spans and metric points (OTLP/HTTP from the bridge)
otelcol.receiver.otlp "demo" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces  = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.exporter.prometheus.local.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

otelcol.exporter.prometheus "local" {
  forward_to = [prometheus.remote_write.local.receiver]
}

prometheus.remote_write "local" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}
