 {
  "key": "DEMO-9",
  "summary": "Checkout should survive transient payment failures",
  "type": "Story",
  "components": [
   "checkout-svc",
   "libs/httpclient"
  ],
  "labels": [],
  "reporter": "Likhith Vardhan Goruputi",
  "assignee": "Likhith Vardhan Goruputi",
  "created": "2026-11-16T03:46:22.112Z",
  "description_versions": [
   {
    "at": "2026-11-16T03:46:22.112Z",
    "text": "Customers see failed orders when payment-svc blips. Make the shared client more resilient: retry more failure kinds and give up on slow attempts sooner."
   }
  ],
  "status_history": [
   {
    "at": "2026-11-16T03:46:22.112Z",
    "status": "Open"
   },
   {
    "at": "2026-11-19T03:46:22.112Z",
    "status": "In Review"
   },
   {
    "at": "2026-11-20T03:46:52.112Z",
    "status": "Done"
   }
  ],
  "comments": [
   {
    "id": "c1",
    "author": "Likhith Vardhan Goruputi",
    "at": "2026-11-19T03:46:22.112Z",
    "body": "PR: retry timeouts and 5xx up to 4 times, per-attempt timeout 250ms, no backoff."
   },
   {
    "id": "c2",
    "author": "Praneeth Kadem",
    "at": "2026-11-19T06:10:22.112Z",
    "body": "250ms is below payment's latency for large charges (risk review). Are we sure?"
   },
   {
    "id": "c3",
    "author": "Likhith Vardhan Goruputi",
    "at": "2026-11-19T08:34:22.112Z",
    "body": "Retries cover that: a slow attempt is abandoned and retried."
   }
  ],
  "links": [],
  "fixture": true
 },
