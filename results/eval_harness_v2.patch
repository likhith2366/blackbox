+RELEVANT_PATHS = ("blackbox", "eval", "configs")
+
+
+def git_scoped_status(paths: list[str]) -> dict[str, Any]:
+    """`git status --porcelain -- <paths>`: whether the code/config/snapshot a run depends on
+    differs from HEAD. Unrelated dirty paths elsewhere in the checkout do not count."""
+    try:
+        st = subprocess.run(["git", "status", "--porcelain", "--", *paths], cwd=REPO_ROOT,
+                            capture_output=True, text=True, timeout=20)
+        if st.returncode != 0:
+            return {"scoped_paths": paths, "scoped_dirty": None, "scoped_error": st.stderr.strip()[:300]}
+        lines = [l for l in st.stdout.splitlines() if l.strip()]
+        return {"scoped_paths": paths, "scoped_dirty": bool(lines), "scoped_changes": lines[:50]}
+    except Exception as e:
+        return {"scoped_paths": paths, "scoped_dirty": None, "scoped_error": str(e)[:300]}
+
