 {
  "role": "commit",
  "evidence_id": "commit:d142601",
  "source": "commits",
  "service": "payment-svc",
  "event_time": "2026-11-20T03:44:03.000Z",
  "available_time": "2026-11-20T03:44:03.000Z",
  "version": "d142601",
  "title": "DEMO-41: fast path for micro-charges under $5",
  "content": "commit d142601 2026-11-20T03:44:03.000Z Praneeth Kadem\nDEMO-41: fast path for micro-charges under $5\n\nSmall charges skip the risk provider and velocity queries; they are\nwritten straight to the payments table.\nfiles: M services/payment/VERSION, M services/payment/app.py\n\ndiff --git a/services/payment/VERSION b/services/payment/VERSION\nindex 005119b..437459c 100644\n--- a/services/payment/VERSION\n+++ b/services/payment/VERSION\n@@ -1 +1 @@\n-2.4.1\n+2.5.0\ndiff --git a/services/payment/app.py b/services/payment/app.py\nindex c58e87f..3d547e2 100644\n--- a/services/payment/app.py\n+++ b/services/payment/app.py\n@@ -14,6 +14,7 @@ from services.payment import db\n NAME = \"payment-svc\"\n ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\n LARGE_AMOUNT = 300.0\n+SMALL_CHARGE_LIMIT = 5.0\n \n \n def _iso(dt: datetime) -> str:\n@@ -91,6 +92,12 @@ class Handler(JsonHandler):\n                 LOG.info(\"charge already recorded\", order_id=order_id, payment_id=existing)\n                 self.send_json(200, {\"payment_id\": existing, \"status\": \"approved\"})\n                 return 200\n+            if amount < SMALL_CHARGE_LIMIT:\n+                # Micro-charges skip risk scoring and velocity checks (DEMO-41).\n+                payment_id = db.insert_payment(conn, order_id, customer_id, amount, currency, _iso(now))\n+                LOG.info(\"charge approved\", order_id=order_id, payment_id=payment_id, fast_path=True)\n+                self.send_json(201, {\"payment_id\": payment_id, \"status\": \"approved\"})\n+                return 201\n             with TRACER.span(\"risk.score\", attributes={\"amount\": amount}):\n                 time.sleep(risk_provider_delay_s(order_id, amount))\n             q0 = time.time()\n",
  "content_ref": "commits.jsonl#d142601829cee858851b38811fb27a5ef4621880",
  "attributes": {
   "sha": "d142601829cee858851b38811fb27a5ef4621880",
   "author": "Praneeth Kadem",
   "files": [
    "services/payment/VERSION",
    "services/payment/app.py"
   ]
  },
  "truncated": false,
  "fixture": true
 },
